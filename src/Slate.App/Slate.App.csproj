<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Slate.App</RootNamespace>
    <AssemblyName>Slate</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Many Win32 calls are best-effort: their result is intentionally ignored. -->
    <NoWarn>$(NoWarn);CA1806</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slate.Core\Slate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Slate.App.IntegrationTests" />
  </ItemGroup>

</Project>
