<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515 (make types internal) and CA1062 (null checks) do not fit an app split into a domain library. -->
    <NoWarn>$(NoWarn);CA1515;CA1062;CA1303;CA1031;CA1848;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1716;CA1720;CA1724;CA1002;CA1819;CA5394;CA1805;CA1822;CA1859;CA1056;CA1054;CA1055</NoWarn>
    <Version>1.0.0</Version>
    <Authors>Jigish Patel; Windows port by Kalisen</Authors>
    <Product>Slate</Product>
    <Copyright>Copyright © 2011-2013 Jigish Patel; Windows port © 2026</Copyright>
  </PropertyGroup>
</Project>
